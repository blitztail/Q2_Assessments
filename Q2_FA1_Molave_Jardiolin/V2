def add(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b

def divide(a, b):
    if b == 0:
        return "Cannot divide by zero"
    return a / b

#ESTABILSHES THE FUNCTIONS

num1 = float(input("Enter the first number: "))
num2 = float(input("Enter the second number: "))

#LETS THE USER IMPUT VALUE

print("Choose an operation:")
print("1. Addition")
print("2. Subtraction")
print("3. Multiplication")
print("4. Division")

#PRINTS THE USERS OPTION AFTER CHOOSING NUMBERS

choice = input("Enter your choice (1-4): ")

#LETS USER CHOOSE AN OPERATION

if choice == "1":
    result = add(num1, num2)
elif choice == "2":
    result = subtract(num1, num2)
elif choice == "3":
    result = multiply(num1, num2)
elif choice == "4":
    result = divide(num1, num2)
else:
    result = "invalid choice"

#CALCULATES THE USERS INPUTS DEPENDING ON THE OPERATION CHOOSEN

print("Answer:", result)

